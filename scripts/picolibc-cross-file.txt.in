[binaries]
c = '@CROSS_C_COMPILER@'
ar = '@CROSS_AR@'
strip = '@CROSS_STRIP@'

[host_machine]
system = '@CROSS_SYSTEM@'
cpu_family = '@CROSS_CPU_FAMILY@'
cpu = '@CROSS_CPU@'
endian = '@CROSS_ENDIAN@'

[built-in options]
c_args = [ @CROSS_C_ARGS_LIST@ ]
c_link_args = [ @CROSS_C_LINK_ARGS_LIST@ ]